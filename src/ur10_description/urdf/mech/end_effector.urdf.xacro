<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="ixx" value="1e-6"/>
  <xacro:property name="iyy" value="1e-6"/>
  <xacro:property name="izz" value="1e-6"/>
  
  <xacro:macro name="end_effector" params="parent_link_name prefix">

    <link name="${prefix}ee_link">
      <visual>
        <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
        <geometry>
          <mesh filename="package://ur10_description/meshes/ee/visual/mock-up-end-effector.dae" scale="1 1 1"/>
        </geometry>  
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://ur10_description/meshes/ee/collision/mock-up-end-effector.stl" scale="0.001 0.001 0.001"/>
        </geometry>  
      </collision>

      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0"/>
        <inertia 
          ixx="${ixx}" ixy="0.0" ixz="0.0" 
          iyy="${iyy}" iyz="0.0" 
          izz="${izz}"/>  
      </inertial>
    </link>

    <joint name="${prefix}ee_joint" type="fixed">
        <parent link="${parent_link_name}"/>
        <child link="${prefix}ee_link"/>
        <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
    </joint>

    <link name="${prefix}tcp_link"/>
  
    <joint name="${prefix}tcp_joint" type="fixed">
      <origin xyz="0 0 0.15" rpy="0 0 0"/> 
      <parent link="${parent_link_name}"/> 
      <child link="${prefix}tcp_link"/>
    </joint>

  </xacro:macro>
</robot>