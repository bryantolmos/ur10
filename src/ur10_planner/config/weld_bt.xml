<root BTCPP_format="4">
    <BehaviorTree ID="MainTree">
        <Sequence name="WeldSequence">
            
            <RetryUntilSuccessful num_attempts="3">
                <GeneratePath name="GeneratePath"/>
            </RetryUntilSuccessful>
            
            <RetryUntilSuccessful num_attempts="2">
                <Timeout msec="60000">
                    <ExecuteWeld name="ExecuteWeld"/>
                </Timeout>
            </RetryUntilSuccessful>

        </Sequence>
    </BehaviorTree>
</root>