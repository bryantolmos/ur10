<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur10_with_custom_ee">
    <group name="arm">
        <chain base_link="base_link" tip_link="custom_tcp_link" />
    </group>
    
    <group name="welding_torch">
        <joint name="custom_ee_joint"/>
        <joint name="custom_tcp_joint"/> 
    </group>
    
    <group_state name="Home" group="arm">
        <joint name="elbow_joint" value="-2.1651"/>
        <joint name="shoulder_lift_joint" value="-1.0504"/>
        <joint name="shoulder_pan_joint" value="0"/>
        <joint name="wrist_1_joint" value="-1.457"/>
        <joint name="wrist_2_joint" value="1.57"/>
        <joint name="wrist_3_joint" value="0"/>
    </group_state>
    <group_state name="Away" group="arm">
        <joint name="elbow_joint" value="-2.4296"/>
        <joint name="shoulder_lift_joint" value="-0.7116"/>
        <joint name="shoulder_pan_joint" value="0"/>
        <joint name="wrist_1_joint" value="3.1513"/>
        <joint name="wrist_2_joint" value="1.5248"/>
        <joint name="wrist_3_joint" value="0"/>
    </group_state>
    
    <end_effector name="welding_torch_end_effector" parent_link="custom_tcp_link" group="welding_torch" parent_group="arm"/>
    
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
    
    <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="base_link_inertia" link2="upper_arm_link" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="custom_ee_link" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="custom_ee_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="custom_ee_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
</robot>